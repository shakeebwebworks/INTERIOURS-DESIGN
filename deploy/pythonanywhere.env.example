# Settings for backend/.env on PythonAnywhere.
# Replace USERNAME with your PythonAnywhere username (3 places) and make a NEW secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=paste-a-new-long-random-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=USERNAME.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://USERNAME.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com
FRONTEND_URL=https://USERNAME.pythonanywhere.com
NUM_PROXIES=1
FRONTEND_DIST_DIR=/home/USERNAME/haven-hue-interiors/frontend/dist
CONSULTATION_NOTIFY_EMAILS=studio@havenandhue.example