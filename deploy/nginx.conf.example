# Example Nginx site for one domain: React build + Django API, admin, photos.
# Replace yourdomain.com and the paths, then enable it and run Certbot for HTTPS.
server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Admin photo uploads can be several MB each
    client_max_body_size 25M;

    # The built React site (frontend/dist uploaded here)
    root /var/www/haven-hue/frontend;
    index index.html;

    # Django (gunicorn listens on 127.0.0.1:8001)
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Admin CSS/JS (from "python manage.py collectstatic") and uploaded photos
    location /static/ {
        alias /srv/haven-hue/backend/staticfiles/;
    }

    location /media/ {
        alias /srv/haven-hue/backend/media/;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Hashed React build files can be cached for a year
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else is a React route
    location / {
        try_files $uri /index.html;
    }
}