# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Public address of the React website (used in sitemap.xml and robots.txt)
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of Django. 0 in development, 1 behind Nginx.
NUM_PROXIES=0